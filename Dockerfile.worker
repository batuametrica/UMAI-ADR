ARG SOURCE_DATE_EPOCH
FROM python:3.12.6-slim-bookworm@sha256:ad48727987b259854d52241fac3bc633574364867b8e20aec305e6e7f4028b26

ARG UMAI_WORKER_VERSION=0.0.0-dev
LABEL org.opencontainers.image.title="UMAI ADR Worker" \
      org.opencontainers.image.version="${UMAI_WORKER_VERSION}" \
      org.opencontainers.image.vendor="UMAI" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY worker-requirements.txt worker-requirements.lock ./
RUN pip install --no-compile --require-hashes --requirement worker-requirements.lock \
    && groupadd --system umai \
    && useradd --system --gid umai --home-dir /app --shell /usr/sbin/nologin umai

COPY umai ./umai
COPY Detection/config_detector.yaml ./Detection/config_detector.yaml
COPY Detection/openai_config.py ./Detection/openai_config.py
COPY Detection/guardrail ./Detection/guardrail
# The reasoning stage's context providers read the threat framework and the
# policy store from here. Without them `_load_yaml` returns `{}` and every
# lookup tool answers "nothing found" — the agent then reports no technique and
# no policy match for every session it examines, which reaches the operator as
# a finding with `technique_id: null` and `category: other`. The failure is
# silent by construction: the tools work, they are just empty.
COPY Detection/context_providers/data ./Detection/context_providers/data
RUN chown -R umai:umai /app
USER umai

EXPOSE 9100
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9100/healthz', timeout=3)"
ENTRYPOINT ["python", "-m", "umai.worker"]
